# Copy to .env.local for local development. All are optional.
# The draft's own lead endpoint (a separate deployment of backend/). Without it the forms open the visitor's email client.
VITE_CONTACT_ENDPOINT=
# The "Client dashboard" link in the nav. Without it the link is not rendered.
VITE_CLIENT_DASHBOARD_URL=
# Canonical origin of this draft.
VITE_SITE_URL=https://azam-stack.github.io/flowa-website-lab
# "false" removes the noindex meta. Leave unset while the site is a draft.
VITE_DRAFT=
