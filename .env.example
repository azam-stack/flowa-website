# Copy to .env.local for local development. All are optional.
# The lead endpoint (backend/). Without it the form opens the visitor's email client.
VITE_CONTACT_ENDPOINT=
# The canonical booking flow (Calendly, Cal.com, HubSpot Meetings). Without it "Book a call" goes to the lead form.
VITE_BOOKING_URL=
# Where analytics events are beaconed as JSON. Without it events only go to window.dataLayer.
VITE_ANALYTICS_ENDPOINT=
